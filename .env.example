# Pooled connection (Neon → Connect → pooled) — для приложения на Vercel / «рабочая» БД
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (Neon → Connect → direct) — для Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Локальная PostgreSQL для /view-db (опционально)
# LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profzor?sslmode=disable"

# В production разрешить /view-db (по умолчанию только development)
# VIEW_DB_ENABLED="true"

# Auth.js (NextAuth v5)
AUTH_SECRET="сгенерируйте: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
AUTH_URL="http://localhost:3000"

# Google OAuth (имена из PROMPT.md; Auth.js также понимает AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
