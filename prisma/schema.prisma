generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model Radical {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameRu    String
  sortOrder Int
  createdAt DateTime @default(now())

  cards Card[]

  @@index([sortOrder])
}

/// Пользователь приложения + Auth.js (Google OAuth / Credentials).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Для Google OAuth может быть null; для Credentials — обязателен на уровне приложения
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  cards           Card[]
  comments        Comment[]
  likes           Like[]
  prompts         Prompt[]
  interviewLikes  InterviewLike[]

  @@index([role])
}

/// Вопрос интервью в личном кабинете (PROMPT (1).md)
model Prompt {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String
  isPublic   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes InterviewLike[]

  @@index([userId, updatedAt])
  @@index([isPublic, updatedAt])
  @@index([userId, isFavorite, updatedAt])
}

/// Лайк публичного интервью (PROMPT.md): 1 пользователь = 1 лайк
model InterviewLike {
  id          String   @id @default(cuid())
  userId      String
  interviewId String
  createdAt   DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview Prompt @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([userId, interviewId])
  @@index([interviewId])
}

/// OAuth-аккаунты (Google и др.) — таблица Auth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Database sessions (Auth.js strategy: "database")
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Карточка вопроса (= «промт» из PROMPT.md: владелец = authorId)
model Card {
  id        String   @id @default(cuid())
  authorId  String
  radicalId String
  title     String
  body      String
  isHidden  Boolean  @default(false)
  /// Приватная карточка видна только владельцу
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  radical  Radical  @relation(fields: [radicalId], references: [id], onDelete: Restrict)
  comments Comment[]
  likes    Like[]

  @@index([createdAt])
  @@index([radicalId, createdAt])
  @@index([authorId, updatedAt])
  @@index([isHidden, createdAt])
  @@index([isPrivate, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  body      String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([cardId])
  @@index([userId])
}
